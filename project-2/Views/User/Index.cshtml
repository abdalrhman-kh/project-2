@model project_2.ViewModels.AppointmentViewModel
@{
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<link rel="stylesheet" href="~/assets/css/main.css" />
<style>
	.Formcontainer {
		height: calc(100vh - 128px);
	}

	.row {
		margin: 0;
	}
</style>
<header>
	<nav class="navbar bg-body-tertiary fixed-top shadow">
		<div class="container justify-content-center">
			<div class="navbar-brand mb-0">
				<img src="~/Images/Dental-Logo-Design.jpg"
					 alt="Dentist Logo"
					 class="navbar-logo" />
			</div>
			<div class="navbar-brand mb-0">
				<button type="button" class="" data-bs-toggle="modal" data-bs-target="#ViewAppointmentpopup">
					View my appointment
				</button>
			</div>
		</div>
	</nav>
</header>
<body>
		<div class="row position-relative">
			<div class="d-flex justify-content-center align-items-center Formcontainer">
				<div class="card shadow" style="width:36rem;">
					<div class="card-body m-3">
						<h3 class="card-title mb-4">Book an appointment</h3>
						<form method="post" asp-action="Create" id="AppointmentForm">
							<div class="row gtr-uniform">
								<div class="col-12 mb-3">
									<input asp-for="PatientName" class="form-control" placeholder="Patient Name" />
									<span asp-validation-for="PatientName" class="text-danger"></span>
								</div>
								<div class="col-12 mb-3">
									<input asp-for="Email" class="form-control" placeholder="Email" />
									<span asp-validation-for="Email" class="text-danger"></span>
								</div>
								<div class="col-12 mb-3">
									<input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
									<span asp-validation-for="PhoneNumber" class="text-danger"></span>
								</div>
								<div class="col-6">
									<select asp-for="Subject" class="form-control" asp-items="Model.SubjectList"></select>
								</div>
								<div class="col-6">
									<input type="text"
										   id="scheduleDate"
										   class="form-control"
										   placeholder="Select available date"
										   readonly />
									<input type="hidden" asp-for="ScheduleId" id="scheduleId" />
								</div>
								<div class="col-6">
									<select asp-for="SlotStartTimeString"
											asp-items="Model.AvailableSlots"
											class="form-control"
											id="slotSelect"
											disabled>
										<option value="">-- Select Time Slot --</option>
									</select>
								</div>
								<div class="col-12 d-grid gap-2">
									<ul class="actions">
										<li><input type="submit" value="Book Appointment" class="primary" /></li>
										<li><input type="reset" value="Reset" /></li>
									</ul>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
		<div class="mb-4 Doctor-Card">
			<div class="card shadow" style="max-width: 350px; max-height:auto;">
				<div class="card-body text-center p-5 d-flex flex-column">
					<img class="card-img-top" src="..." alt="Card image cap">
					<div class="card-body">
						<h5 class="card-title">Card title</h5>
						<p class="card-text">
							Some quick example text to build on the card title and make up the bulk of the card's content.
							Some quick example text to build on the card title and make up the bulk of the card's content.
						</p>
						<a href="#" class="btn btn-primary">Go somewhere</a>
					</div>
				</div>
			</div>
		</div>
	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success alert-fixed">
			@TempData["SuccessMessage"]
		</div>
	}

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger alert-fixed">
			@TempData["ErrorMessage"]
		</div>
	}


	<div class="modal fade" id="ViewAppointmentpopup" tabindex="-1" aria-labelledby="ViewAppointmentpopupLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="ViewAppointmentpopupLabel">My Appointment</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="resetSearch()"></button>
				</div>
				<div class="modal-body">
					<div id="searchForm">
						<div class="mb-3">
							<label for="SearchEmail" class="form-label">Email</label>
							<input type="email" class="form-control" id="SearchEmail" placeholder="Enter your email" required />
						</div>
						<div class="mb-3">
							<label for="SearchPhone" class="form-label">Phone Number</label>
							<input type="tel" class="form-control" id="SearchPhone" placeholder="Enter your phone number" required />
						</div>
						<button type="button" id="PopupSubmit" class="primary w-100" onclick="RequestOTP()">Search appointments</button>
					</div>
					<div id="OTPModel" style="display:none;">
						<div class="container height-100 d-flex justify-content-center align-items-center">
							<div class="position-relative">
								<div class="card p-2 text-center">
									<h6>Please enter the one time password <br> to verify your account</h6>
									<div> <span>A code has been sent to</span> <small id="maskedEmail"></small> </div>
									<div id="otp-input" class="inputs d-flex flex-row justify-content-center mt-2">
										<input class="m-2 text-center form-control rounded" type="text" id="first" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="second" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="third" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="fourth" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="fifth" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="sixth" maxlength="1" />
									</div>
									<button type="button" class="primary w-100 mb-1" onclick="SearchAppointments()">Validate</button>
									<button type="button" class="secondary w-100" onclick="resetSearch()">Go back</button>
								</div>
							</div>
						</div>

					</div>
					<div id="appointmentResults" style="display:none;">
						<div class="alert alert-info">
							<strong>Your appointments</strong>
						</div>
						<div id="appointmentsList"></div>
						<button type="button" class="secondary mt-3" onclick="resetSearch()">
							Search Again
						</button>
					</div>
					<div id="noResults" style="display: none;">
						<div class="alert alert-warning">
							No appointments found with this email and phone number.
						</div>
						<button type="button" class="btn btn-secondary" onclick="resetSearch()">
							Try Again
						</button>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="secondary" data-bs-dismiss="modal" onclick="resetSearch()">Close</button>
				</div>
			</div>
		</div>
	</div>








	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
	<script src="~/assets/js/jquery.min.js"></script>
	<script src="~/assets/js/browser.min.js"></script>
	<script src="~/assets/js/breakpoints.min.js"></script>
	<script src="~/assets/js/util.js"></script>
	<script src="~/assets/js/main.js"></script>
	<script>
		setTimeout(function () {
			const alerts = document.querySelectorAll('.alert-fixed');
			alerts.forEach(a => a.style.display = 'none');
		}, 4000);
	</script>
	<script>
		const schedules = @Html.Raw(Json.Serialize(ViewBag.ScheduleDates));

		flatpickr("#scheduleDate", {
			enable: schedules.map(s => s.date),
			dateFormat: "Y-m-d",
			minDate: "today",
			onChange: function (selectedDates, dateStr) {

				const selected = schedules.find(s => s.date === dateStr);
				if (!selected) return;

				document.getElementById("scheduleId").value = selected.id;

				const slotSelect = document.getElementById("slotSelect");
				slotSelect.innerHTML = '<option value="">-- Select Time Slot --</option>';
				slotSelect.disabled = true;

				fetch(`/User/GetSlots?scheduleId=${selected.id}`)
					.then(res => res.json())
					.then(data => {
						data.forEach(slot => {
							const option = document.createElement("option");
							option.value = slot.value;
							option.text = slot.text;
							slotSelect.appendChild(option);
						});
						slotSelect.disabled = false;
					});
			}
		});
	</script>
	<script>
		document.getElementById("AppointmentForm").addEventListener("reset",function(){
			document.getElementById("scheduleDate")._flatpickr.clear();
			document.getElementById("scheduleId").value="";
			const slotSelect = document.getElementById("slotSelect");
			slotSelect.innerHTML = '<option value="">-- Select Time Slot --</option>';
			slotSelect.disabled = true;
		})
	</script>
	<script>
		async function RequestOTP(){
			const email = document.getElementById("SearchEmail").value;
			const phone = document.getElementById("SearchPhone").value;

			document.getElementById("maskedEmail").innerHTML = email;

			if (!email || !phone) {
				alert('Please enter both email and phone number');
				return;
			}
			document.getElementById("PopupSubmit").disabled = true;
			const data = await fetch('/User/RequestOTP',{
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: email })
			});

			if (!data.ok) {
				const errorText = await data.text();
				console.error("Server Error:", errorText);
				alert("Failed to send OTP. Status: " + data.status);
				return;
			}
			
			document.getElementById('searchForm').style.display = 'none';

			if(data.ok){
				document.getElementById('searchForm').style.display = 'none';
				document.getElementById('OTPModel').style.display = 'block';
			} 
			else {
				alert("Failed to send OTP. Please try again.");
			}
		}


		async function SearchAppointments(){
			const email = document.getElementById("SearchEmail").value;

			const otpInputs = document.querySelectorAll("#otp-input > input");
			let fullcode = "";
			otpInputs.forEach(input =>{
				fullcode +=input.value;
			});
			if (fullcode.length < 6) {
				alert("Please enter the full 6-digit code.");
				return;
			}
			const data = await fetch('/User/VerifyOTP',{
				method: 'POST',
				headers:{ 'Content-Type': 'application/json' },
				body:JSON.stringify({ 
					email: email,
					code: fullcode,
				})
			});
			if(data.ok){
				const response = await data.json();
				document.getElementById('OTPModel').style.display = 'none';

				if(response && response.length > 0){
					displayAppointments(response)
				}
				else{
					document.getElementById("noResults").style.display = "block";
				}
			}
		}

		function displayAppointments(appointments){
			const listDiv = document.getElementById("appointmentsList");
			listDiv.innerHTML = "";
			appointments.forEach(apt => {
				const card = document.createElement("div");
				card.className = "card mb-2";
				card.innerHTML = `
				<div class="card-body">
					<h6 class="card-title">${apt.subject}</h6>
					<p class="card-text mb-1">
						<strong>Date:</strong> ${new Date(apt.startTime).toLocaleDateString()}<br>
						<strong>Time:</strong> ${new Date(apt.startTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}<br>
						<strong>Patient:</strong> ${apt.patientName}
					</p>
				</div>
			`;
			listDiv.appendChild(card);
			});
			 document.getElementById('appointmentResults').style.display = 'block';
		}

		function resetSearch(){
			document.getElementById('searchForm').style.display = 'block';
			document.getElementById("PopupSubmit").disabled = false;
			document.getElementById('OTPModel').style.display = 'none';
			document.getElementById('appointmentResults').style.display = 'none';
			document.getElementById('noResults').style.display = 'none';
			document.getElementById('SearchEmail').value = '';
			document.getElementById('SearchPhone').value = '';

				const inputs = document.querySelectorAll('#otp-input input');
				inputs.forEach(input => {
				input.value = "";
			});
		}
	</script>
	<script>
		document.addEventListener("DOMContentLoaded", function() {
			function OTPInput() {
				const inputs = document.querySelectorAll('#otp-input > input');
				for (let i = 0; i < inputs.length; i++) {
					inputs[i].addEventListener('input', function() {
						if (this.value.length > 1) {
							this.value = this.value[0]; //
						}
						if (this.value !== '' && i < inputs.length - 1) {
							inputs[i + 1].focus(); //
						}
					});

					inputs[i].addEventListener('keydown', function(event) {
						if (event.key === 'Backspace') {
							this.value = '';
							if (i > 0) {
								inputs[i - 1].focus();
							}
						}
					});
				}
			}

			OTPInput();

			const validateBtn = document.getElementById('validateBtn');
			validateBtn.addEventListener('click', function() {
				let otp = '';
				document.querySelectorAll('#otp-input > input').forEach(input => otp += input.value);
			});
		});
	</script>
</body>