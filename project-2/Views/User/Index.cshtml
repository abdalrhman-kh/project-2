@model project_2.ViewModels.UserViewModels
@{
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<link rel="stylesheet" href="~/assets/css/main.css" />
<style>
	.Formcontainer {
		height: calc(100vh - 128px);
	}

	.row {
		margin: 0;
	}

	.swal2-styled {
		line-height: 1.5 !important;
		padding: 0.625em 1.1em !important;
		font-family: 'Helvetica', 'Arial', sans-serif !important;
		letter-spacing: normal !important;
		text-transform: none !important;
		font-size: 1rem !important;
	}

	.swal2-icon.swal2-warning {
		border-color: #f8bb86 !important;
		color: #f8bb86 !important;
		margin-top: 20px !important;
	}

	.swal2-confirm {
		background-color: #3085d6 !important;
		color: #fff !important;
	}

	.swal2-cancel {
		background-color: #d33 !important;
		color: #fff !important;
		text-transform: uppercase !important;
	}

	.swal2-container {
		z-index: 10000 !important;
	}

	#Paragraph {
		font-family: "Raleway", Helvetica, sans-serif;
		font-size: 0.8rem;
		letter-spacing: 0.175em;
		line-height: 2.5;
	}
</style>
<header>
	<nav class="navbar bg-body-tertiary fixed-top shadow">
			<div class="navbar-brand mb-0">
				<img src="~/Images/Dental-Logo-Design.jpg"
					 alt="Dentist Logo"
					 class="navbar-logo" />
			</div>
			<div class="navbar-brand mb-0">
				<button type="button" style="box-shadow:none; text-decoration:underline;" data-bs-toggle="modal" data-bs-target="#ViewAppointmentpopup">
					View my appointment
				</button>
			</div>
	</nav>
</header>
<body>
		<div class="row position-relative">
			<div class="d-flex justify-content-center align-items-center Formcontainer">
				<div class="card shadow" style="width:36rem;">
					<div class="card-body m-3">
						<h3 class="card-title mb-4">Book an appointment</h3>
						<form method="post" asp-action="Create" id="AppointmentForm">
							<div class="row gtr-uniform">
								<div class="col-12 mb-3">
									<input asp-for="AppointmentView.PatientName" class="form-control" placeholder="Patient Name" />
								<span asp-validation-for="AppointmentView.PatientName" class="text-danger"></span>
								</div>
								<div class="col-12 mb-3">
								<input asp-for="AppointmentView.Email" class="form-control" placeholder="Email" />
								<span asp-validation-for="AppointmentView.Email" class="text-danger"></span>
								</div>
								<div class="col-12 mb-3">
								<input asp-for="AppointmentView.PhoneNumber" class="form-control" placeholder="Phone Number" />
								<span asp-validation-for="AppointmentView.PhoneNumber" class="text-danger"></span>
								</div>
								<div class="col-6">
								<select asp-for="AppointmentView.Subject" class="form-control" asp-items="Model.AppointmentView.SubjectList"></select>
								</div>
								<div class="col-6">
									<input type="text"
										   id="scheduleDate"
										   class="form-control"
										   placeholder="Select available date"
										   readonly />
								<input type="hidden" asp-for="AppointmentView.ScheduleId" id="scheduleId" />
								</div>
								<div class="col-6">
								<select asp-for="AppointmentView.SlotStartTimeString"
										asp-items="Model.AppointmentView.AvailableSlots"
											class="form-control"
											id="slotSelect"
											disabled>
										<option value="">-- Select Time Slot --</option>
									</select>
								</div>
								<div class="col-12 d-grid gap-2">
									<ul class="actions">
										<li><input type="submit" value="Book Appointment" class="primary" /></li>
										<li><input type="reset" value="Reset" /></li>
									</ul>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
		<div class="mb-4 Doctor-Card">
			<div class="card shadow" style="max-width: 450px; max-height:auto;">
				<div class="card-body text-center p-5 d-flex flex-column">
					<img class="card-img-top" src="~/@Model.DentistView.DentistImage" alt="Dentist Image">
					<div class="card-body">
						<h5 class="card-title">Info Card</h5>
						<p class="card-text text-start" id="Paragraph">
						<span>Name: @Model.DentistView.Name</span><br />
						<span>Experience: @Model.DentistView.Experience years</span><br />
						<span>Collage: @Model.DentistView.Collage</span><br />
						<span>Email: @Model.DentistView.Email</span><br />
						<span>PhoneNumber: @Model.DentistView.PhoneNumber</span><br />
						</p>
					</div>
				</div>
			</div>
		</div>

	<div class="mb-4 Abt-Card">
		<div class="card shadow" style="max-width: 450px; max-height:auto;">
			<div class="card-body text-center p-5 d-flex flex-column">
				<h5 class="card-title">Available Times <span class="tip" data-bs-placment="top" title="this only shows the first 5 time slots">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-circle" viewBox="0 0 16 16">
							<path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
							<path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94" />
						</svg>
				</span></h5>
				<div class="d-flex justify-content-evenly">
					<div class="d-flex flex-column align-items-center gap-2">
						<strong id="today">Today </strong>
						<div id="slots-today" class="d-flex flex-column gap-1"></div>
					</div>
					&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
					<div class="d-flex flex-column align-items-center gap-2">
						<strong id="tomorrow"></strong>
						<div id="slots-tomorrow" class="d-flex flex-column gap-1"></div>
					</div>
					&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
					<div class="d-flex flex-column align-items-center gap-2">
						<strong id="theDayAfter"></strong>
						<div id="slots-theDayAfter" class="d-flex flex-column gap-1"></div>
					</div>
				</div>
			</div>
		</div>
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success alert-fixed">
			@TempData["SuccessMessage"]
		</div>
	}

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger alert-fixed">
			@TempData["ErrorMessage"]
		</div>
	}


	<div class="modal fade" id="ViewAppointmentpopup" tabindex="-1" aria-labelledby="ViewAppointmentpopupLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="ViewAppointmentpopupLabel">My Appointment</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="resetSearch()"></button>
				</div>
				<div class="modal-body">
					<div id="searchForm">
						<div class="mb-3">
							<label for="SearchEmail" class="form-label">Email</label>
							<input type="email" class="form-control" id="SearchEmail" placeholder="Enter your email" required />
						</div>
						<button type="button" id="PopupSubmit" class="primary w-100" onclick="RequestOTP()">Search appointments</button>
					</div>
					<div id="OTPModel" style="display:none;">
						<div class="container height-100 d-flex justify-content-center align-items-center">
							<div class="position-relative">
								<div class="card p-2 text-center">
									<h6>Please enter the one time password <br> to verify your account</h6>
									<div> <span>A code has been sent to</span> <small id="maskedEmail"></small> </div>
									<div id="otp-input" class="inputs d-flex flex-row justify-content-center mt-2">
										<input class="m-2 text-center form-control rounded" type="text" id="first" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="second" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="third" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="fourth" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="fifth" maxlength="1" />
										<input class="m-2 text-center form-control rounded" type="text" id="sixth" maxlength="1" />
									</div>
									<button type="button" class="primary w-100 mb-1" id="validateBtn" onclick="SearchAppointments()">Validate</button>
								</div>
							</div>
						</div>

					</div>
					<div id="appointmentResults" style="display:none;">
						<div class="alert alert-info">
							<strong>Your appointments</strong>
						</div>
						<div id="appointmentsList"></div>
					</div>
					<div id="noResults" style="display: none;">
						<div class="alert alert-warning">
							No appointments found with this email and phone number.
						</div>
						<button type="button" class="btn btn-secondary" onclick="resetSearch()">
							Try Again
						</button>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="secondary" data-bs-dismiss="modal" onclick="resetSearch()">Close</button>
				</div>
			</div>
		</div>
	</div>


	<div class="modal fade" id="EditModel" tabindex="-1" role="dialog" aria-labelledby="editAppoitment" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="editAppoitment">Reschedule Appointment</h5>
				</div>
				<div class="modal-body">
					<form method="post" asp-action="EditApt" id="AppointmentForm">
						<input asp-for="AppointmentView.AppointmentId" type="hidden" id="editId" />
						<div class="row gtr-uniform">
							<div class="col-12 mb-3">
								<input asp-for="AppointmentView.PatientName" id="editName" class="form-control" placeholder="Patient Name" />
								<span asp-validation-for="AppointmentView.PatientName" class="text-danger"></span>
							</div>
							<div class="col-12 mb-3">
								<input asp-for="AppointmentView.Email" id="editEmail" class="form-control" placeholder="Email" />
								<span asp-validation-for="AppointmentView.Email" class="text-danger"></span>
							</div>
							<div class="col-12 mb-3">
								<input asp-for="AppointmentView.PhoneNumber" id="editPhone" class="form-control" placeholder="Phone Number" />
								<span asp-validation-for="AppointmentView.PhoneNumber" class="text-danger"></span>
							</div>
							<div class="col-6 mb-3">
								<select asp-for="AppointmentView.Subject" id="editSubject" class="form-control" asp-items="Model.AppointmentView.SubjectList"></select>
							</div>
							<div class="col-6 mb-3">
								<input type="text"
									   id="editScheduleDate"
									   class="form-control"
									   placeholder="Select available date"
									   readonly />
								<input type="hidden" asp-for="AppointmentView.ScheduleId" id="editDate" />
							</div>
							<div class="col-6 mb-3">
								<select asp-for="AppointmentView.SlotStartTimeString"
										asp-items="Model.AppointmentView.AvailableSlots"
										class="form-control"
										id="editTime"
										disabled>
									<option value="">-- Select Time Slot --</option>
								</select>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn secondary" onclick="resetSearch()" data-bs-dismiss="modal">Cancel</button>
							<button type="button" class="btn primary" onclick="ConfirmEdit()">Edit</button>
							<button type="button" class="btn danger" onclick="ConfirmDelete()">DELETE</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>





	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="~/assets/js/jquery.min.js"></script>
	<script src="~/assets/js/browser.min.js"></script>
	<script src="~/assets/js/breakpoints.min.js"></script>
	<script src="~/assets/js/util.js"></script>
	<script src="~/assets/js/main.js"></script>
	<script>
		setTimeout(function () {
			const alerts = document.querySelectorAll('.alert-fixed');
			alerts.forEach(a => a.style.display = 'none');
		}, 4000);
	</script>
	<script>
		async function loadDates(){
			const response = await fetch("/User/GetDates");
			const setDates = await response.json();

			flatpickr("#scheduleDate", {
				enable: setDates,
				dateFormat: "Y-m-d",
				minDate: "today",
				onChange: async function (selectedDates, dateStr) {

					const selected = await fetch(`/User/FindDates?Date=${dateStr}`);
					const data = await selected.json();

					document.getElementById("scheduleId").value = data.id;

					const slotSelect = document.getElementById("slotSelect");
					slotSelect.innerHTML = '<option value="">-- Select Time Slot --</option>';
					slotSelect.disabled = true;

					await fetch(`/User/GetSlots?scheduleId=${data.id}`)
						.then(res => res.json())
						.then(data => {
							data.forEach(slot => {
								const option = document.createElement("option");
								option.value = slot.value;
								option.text = slot.text;
								slotSelect.appendChild(option);
							});
							slotSelect.disabled = false;
						});
				}
			});
			flatpickr("#editScheduleDate", {
				enable: setDates,
				dateFormat: "Y-m-d",
				minDate: "today",
				onChange: async function (selectedDates, dateStr) {

					const selected = await fetch(`/User/FindDates?Date=${dateStr}`);
					const data = await selected.json();

					document.getElementById("editDate").value = data.id;

					const slotSelect = document.getElementById("editTime");
					slotSelect.innerHTML = '<option value="">-- Select Time Slot --</option>';
					slotSelect.disabled = true;

					await fetch(`/User/GetSlots?scheduleId=${data.id}`)
						.then(res => res.json())
						.then(data => {
							data.forEach(slot => {
								const option = document.createElement("option");
								option.value = slot.value;
								option.text = slot.text;
								slotSelect.appendChild(option);
							});
							slotSelect.disabled = false;
						});
				}
			});
		}
		loadDates();

		async function loadTimes(){

			const response = await fetch("/User/GetNextAvailableDates");
			const dates = await response.json();
			const ids = ["today", "tomorrow", "theDayAfter"];

			for(let index = 0; index < ids.length; index++){
				const id = ids[index];
				const el = document.getElementById(id);
				const slotDiv = document.getElementById(`slots-${id}`);
				if(!el) continue;

				if(dates[index]){
					const parts = dates[index].date.split('-');
					const date = new Date(parts[0], parts[1] - 1, parts[2]);
					el.innerText = `${String(date.getDate()).padStart(2,'0')}/${String(date.getMonth()+1).padStart(2,'0')}`;

					const slotRes = await fetch(`/User/GetSlots?scheduleId=${dates[index].id}`);
					const slots = await slotRes.json();

					slotDiv.innerHTML = "";

					if(slots.length == 0)
					slotDiv.innerHTML = `<small class="text-muted">No slots</small>`;

					else{
						slots.slice(0,5).forEach(slot => {
							const btn = document.createElement("button");
							btn.className = "secondary";
							btn.style.fontSize = "10px";
							btn.textContent = slot.text;

							btn.onclick = async () => {
								document.getElementById("scheduleId").value = dates[index].id;
								document.getElementById("scheduleDate")._flatpickr.setDate(dates[index].date);

								const slotSelect = document.getElementById("slotSelect");
								slotSelect.innerHTML = '<option value="">-- Select Time Slot --</option>';

								slots.forEach(s => {
									const option = document.createElement("option");
									option.value = s.value;
									option.text = s.text;
									slotSelect.appendChild(option);
								});
								document.getElementById("slotSelect").disabled = false;
								document.getElementById("slotSelect").value = slot.value;
							};
						slotDiv.appendChild(btn);
						});
					}
				}
				else{
					slotDiv.innerHTML = `<small class="text-muted">N/A</small>`;
				}
			}
		}
		loadTimes();
	</script>
	<script>
		document.getElementById("AppointmentForm").addEventListener("reset",function(){
			document.getElementById("scheduleDate")._flatpickr.clear();
			document.getElementById("scheduleId").value="";
			const slotSelect = document.getElementById("slotSelect");
			slotSelect.innerHTML = '<option value="">-- Select Time Slot --</option>';
			slotSelect.disabled = true;
		})
	</script>
	<script>
		async function RequestOTP(){
			const email = document.getElementById("SearchEmail").value;


			if (!email) {
				Swal.fire("Error", "Please enter both email and phone number");
				return;
			}
			document.getElementById("PopupSubmit").disabled = true;
			const data = await fetch('/User/RequestOTP',{
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: email })
			});
			

			if(data.ok){
				document.getElementById("maskedEmail").innerHTML = email;
				document.getElementById('searchForm').style.display = 'none';
				document.getElementById('OTPModel').style.display = 'block';
			} 
			else if (data.status === 409){
				const result = await data.json();

				await Swal.fire({
					title: "Code Already Sent",
					text: result.message,
					confirmButtonText: "I'll check my inbox"
				});
				document.getElementById("maskedEmail").innerHTML = email;
				document.getElementById('searchForm').style.display = 'none';
				document.getElementById('OTPModel').style.display = 'block';
			}
			else {
				Swal.fire("Error", "Failed to send OTP. Please try again later.");
				submitBtn.disabled = false;
			}
		}


		async function SearchAppointments(){
			const email = document.getElementById("SearchEmail").value;

			const otpInputs = document.querySelectorAll("#otp-input > input");
			let fullcode = "";
			otpInputs.forEach(input =>{
				fullcode +=input.value;
			});
			if (fullcode.length < 6) {
				await Swal.fire({
					title: "ERROR!",
					text: "Please enter the full 6 diget code.",
				});
				return;
			}
			const data = await fetch('/User/VerifyOTP',{
				method: 'POST',
				headers:{ 'Content-Type': 'application/json' },
				body:JSON.stringify({ 
					email: email,
					code: fullcode,
				})
			});
			if(data.ok){
				const response = await data.json();
				document.getElementById('OTPModel').style.display = 'none';

				if(response && response.length > 0){
					displayAppointments(response)
				}
				else{
					document.getElementById("noResults").style.display = "block";
				}
			}
			else{
				await Swal.fire({
					title: "ERROR!",
					text: "Wrong code please try again.",
				});
			}
		}

		function displayAppointments(appointments){
			const listDiv = document.getElementById("appointmentsList");
			listDiv.innerHTML = "";
			appointments.forEach(apt => {
				aptString = JSON.stringify(apt).replace(/"/g, '&quot;');
				const card = document.createElement("div");
				card.className = "card mb-2";
				card.innerHTML = `
				<div class="card-body">
					<h6 class="card-title">${apt.subject}</h6>
					<p class="card-text mb-1">
						<strong>Date:</strong> ${new Date(apt.startTime).toLocaleDateString()}<br>
						<strong>Time:</strong> ${new Date(apt.startTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}<br>
						<strong>Patient:</strong> ${apt.patientName}
					</p>
					<button class="btn btn-sm btn-outline-danger" onclick="openEditModal(${aptString})">
					Edit
					</button>
				</div>
			`;
			listDiv.appendChild(card);
			});
			 document.getElementById('appointmentResults').style.display = 'block';
		}

		function openEditModal(data){
			document.getElementById("editId").value = data.appointmentId;
			document.getElementById("editName").value = data.patientName;
			document.getElementById("editEmail").value = data.email;
			document.getElementById("editPhone").value = data.phoneNumber;
			document.getElementById("editSubject").value = data.subject;
			document.getElementById("editDate").value = data.date;
			document.getElementById("editTime").value = data.slotStartTime;

			$('#ViewAppointmentpopup').modal('hide');

			$('body').removeClass('modal-open');
			$('.modal-backdrop').remove();

			setTimeout(function() {
				$('#EditModel').modal('show');
			}, 300);
		}

		async function ConfirmEdit(){
			event.preventDefault();
			const viewmodel = {
				AppointmentId: document.getElementById("editId").value,
				PatientName: document.getElementById("editName").value,
				Email: document.getElementById("editEmail").value,
				PhoneNumber: document.getElementById("editPhone").value,
				Subject: document.getElementById("editSubject").value,
				ScheduleId: document.getElementById("editDate").value,
				SlotStartTimeString: document.getElementById("editTime").value
			};
			Swal.fire({
			title: "Are you sure?",
			text: "Do you want to confirm the edit?",
			showCancelButton: true,
			confirmButtonColor: "#3085d6",
			cancelButtonColor: "#d33",
			confirmButtonText: "Yes, Edit it!"
			}).then( async (result) => {
				if (result.isConfirmed){
					const response = await fetch(`/user/EditApt`,{
						method:"POST",
						headers: {
							"Content-Type": "application/json"
						 },
						body: JSON.stringify(viewmodel)
					});
					if(response.ok){
						Swal.fire({
							title: "Edited!",
							text: "Appointment  has been Changed.",
						});
						location.reload();
					}
					else{
						Swal.fire({
							title: "ERROR!",
							text: "Something went wrong, double check all input fileds ",
						});
					}
				}
			});
		}

		async function ConfirmDelete(){
			event.preventDefault();
			const id = document.getElementById("editId").value;
			Swal.fire({
			title: "Are you sure?",
			text: "You won't be able to revert this!",
			showCancelButton: true,
			confirmButtonColor: "#3085d6",
			cancelButtonColor: "#d33",
			confirmButtonText: "Yes, delete it!"
			}).then( async (result) => {
				if (result.isConfirmed){
					const response = await fetch(`/user/DeleteApt?id=${id}`,{
						method:"POST"
					});
					if(response.ok){
						await Swal.fire({
							title: "Deleted!",
							text: "Appointment  has been deleted.",
						});
						location.reload();
					}
					else{
						await Swal.fire({
							title: "ERROR!",
							text: "Something went wrong",
						});
						location.reload();
					}
				}
			});
		}

		function resetSearch(){
			document.getElementById('searchForm').style.display = 'block';
			document.getElementById("PopupSubmit").disabled = false;
			document.getElementById('OTPModel').style.display = 'none';
			document.getElementById('appointmentResults').style.display = 'none';
			document.getElementById('noResults').style.display = 'none';
			document.getElementById('SearchEmail').value = '';

			const inputs = document.querySelectorAll('#otp-input input');
				inputs.forEach(input => {
				input.value = "";
			});
			location.reload()
		}
	</script>
	<script>
		document.addEventListener("DOMContentLoaded", function() {
			function OTPInput() {
				const inputs = document.querySelectorAll('#otp-input > input');
				for (let i = 0; i < inputs.length; i++) {
					inputs[i].addEventListener('input', function() {
						if (this.value.length > 1) {
							this.value = this.value[0]; 
						}
						if (this.value !== '' && i < inputs.length - 1) {
							inputs[i + 1].focus(); 
						}
					});

					inputs[i].addEventListener('keydown', function(event) {
						if (event.key === 'Backspace') {
							this.value = '';
							if (i > 0) {
								inputs[i - 1].focus();
							}
						}
					});
				}
			}

			OTPInput();

			const validateBtn = document.getElementById('validateBtn');
			validateBtn.addEventListener('click', function() {
				let otp = '';
				document.querySelectorAll('#otp-input > input').forEach(input => otp += input.value);
			});
		});
	</script>
	<script>
		const tooltips = document.querySelectorAll(".tip")
		tooltips.forEach(t=>{
			new bootstrap.Tooltip(t)
		})
	</script>
</body>