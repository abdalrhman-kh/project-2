@model IEnumerable<project_2.ViewModels.AppointmentViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<div>
    <ejs-schedule id="scheduler"
                  currentView="Month"
                  startHour="9:00"
                  endHour="17:00">
                  <e-schedule-eventsettings datasource="@Model"> </e-schedule-eventsettings>
        <e-schedule-views>
            <e-schedule-view option="Day" dateformat="dd-MM-yyyy"></e-schedule-view>
            <e-schedule-view option="Week"></e-schedule-view>
            <e-schedule-view option="Month"></e-schedule-view>
        </e-schedule-views>
    </ejs-schedule>
</div>