@model project_2.ViewModels.ScheduleViewModel

@{
	Layout = null;
}
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
	<meta name="description" content="" />
	<meta name="keywords" content="" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
	<link rel="stylesheet" href="~/AdminTemplate/assets/css/main.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
	<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
	<style>
		.flatpickr-calendar.inline {
			display: block;
			position: absolute;
			top: 50%;
			transform: translate(-50%, -50%);
		}

		#Paragraph {
			font-family: "Raleway", Helvetica, sans-serif;
			font-size: 0.8rem;
			letter-spacing: 0.175em;
			line-height: 2.5;
		}

		#CreateBtn{
			background-color: #000000;
			box-shadow: none;
			color: #FFFF !important;
			border-radius: 4rem;
			line-height: 2rem;
			height: 2rem;
		}
	</style>
</head>
<body class="is-preload">
	<!-- Wrapper -->
	<div id="wrapper">
		<!-- Intro -->
		<section class="intro">
			<header>
				<div class="calendar-container">
					<div id="inline-calendar"></div>
				</div>
			</header>
			<div class="content container-fluid mt-3 pt-3">
				<div class="position-relative">
					<h2>Edit Page</h2>
					<p id="Paragraph">Select a date that is already in your schedule and you can edit it's start time, end time and it's status if you want to create a date in your schedule click here
						<a asp-area="Admin" asp-action="SetSchedule" asp-controller="Appointment" class="button primary" id="CreateBtn">
							Create
						</a>
					</p>
				</div>
				<div class="row position-relative mt-4 pt-3">
					<div class="col-lg-8 col-md-6 mb-4 mx-auto">
						<div class="card shadow">
							<div class="card-body m-3">
								<form asp-action="Edit">
									<div class="row">
										<div class="col-12 mb-3">
											<label class="form-label">Date</label>
											<input type="text" id="DateSelect" class="form-control" placeholder="Select from calendar" readonly />
											<input type="hidden" asp-for="Date" id="DateId" />
											<span asp-validation-for="Date" class="text-danger"></span>
											<input asp-for="ScheduleId" id="ScheduleId" hidden/>
										</div>
										<div class="col-6 mb-3">
											<label class="form-label">Start Time</label>
											<select asp-for="StartTime" id="Start" class="form-control">
												<option></option>
											</select>
											<span asp-validation-for="StartTime" class="text-danger"></span>
										</div>
										<div class="col-6 mb-3">
											<label class="form-label">End Time</label>
											<select asp-for="EndTime" id="End" class="form-control">
												<option></option>
											</select>
											<span asp-validation-for="EndTime" class="text-danger"></span>
										</div>
										<div class="col-12 mb-3">
											<label class="form-label">Status</label>
											<select asp-for="Status" id="Status" class="form-control" asp-items="@Model.StatusList">
											</select>
											<span asp-validation-for="Status" class="text-danger"></span>
										</div>
										<div class="col-12 d-grid gap-2 mt-3">
											<input type="submit" value="Edit" class="primary" />
										</div>
									</div>
								</form>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</div>
	<!-- Scripts -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
	<script src="script.js"></script>
	<script src="~/AdminTemplate/assets/js/jquery.min.js"></script>
	<script src="~/AdminTemplate/assets/js/jquery.scrolly.min.js"></script>
	<script src="~/AdminTemplate/assets/js/browser.min.js"></script>
	<script src="~/AdminTemplate/assets/js/breakpoints.min.js"></script>
	<script src="~/AdminTemplate/assets/js/util.js"></script>
	<script src="~/AdminTemplate/assets/js/main.js"></script>
	<script>
		const TimeFormat = (h) => `${String(h).padStart(2,'0')}:00`;

		function StartTimes(){
			const SelectedStart = document.getElementById("Start");

			for(let i = 9; i<=17;i++){
				const time = TimeFormat(i);
				SelectedStart.options.add(new Option(time,time));
			}
		}

		function EndTimes(StartValue){
			const endselect = document.getElementById("End");
			const endvalue = endselect.value;
			endselect.options.length = 0;
			endselect.disabled = false;
			if(!StartValue){
				endselect.disabled = true;
				return;
			}
			const StartHour = parseInt(StartValue.split(":")[0]);

			for(let i = StartHour + 1; i<=18; i++){
				const time = TimeFormat(i);
				endselect.options.add(new Option(time, time));
			}
			if(endvalue > StartValue){
				endselect.value = endvalue;
			}
		}

		async function loadDates(){
			try{
				StartTimes();
				const response = await fetch("/Admin/appointment/GetDates");
				const setDates = await response.json();
				flatpickr("#inline-calendar", {
					inline: true,
					dateFormat: "Y-m-d",
					minDate: "today",
					enable: setDates,
					onChange: async function (selectedDates, dateStr) {
						document.getElementById("DateSelect").value = dateStr;

						document.getElementById("DateId").value = dateStr;

						const res = await fetch(`/Admin/appointment/FindDates?Date=${dateStr}`);
						const data = await res.json();

						document.getElementById("ScheduleId").value = data.id;
						document.getElementById("Start").value = data.startTime;
						EndTimes(data.startTime);
						document.getElementById("End").value = data.endTime;
						document.getElementById("Status").value = data.status.toString().charAt(0).toUpperCase() + data.status.toString().slice(1);;

						console.error("dateStr is: " + data.endTime);

					}
				})
				document.getElementById("Start").addEventListener("change",function(){
					EndTimes(this.value);
				})
			}
			catch(error){
				console.error("Error loading calendar:", error);
			}
		}
		loadDates();
	</script>
</body>