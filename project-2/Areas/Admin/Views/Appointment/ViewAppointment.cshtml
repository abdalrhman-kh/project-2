@model project_2.ViewModels.AppointmentViewModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AdminLTE 3 | Project Detail</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/ViewAppointmentTemplate/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        #cardCore{
            min-height: calc(100vh - 100px);
        }
    </style>
</head>
<body class="hold-transition sidebar-mini" style="padding-top: 7rem;">
    <!-- Site wrapper -->
    <div class="wrapper">
        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper" style="margin-left:0;">
            <!-- Main content -->
            <section class="content">

                <!-- Default box -->
                <div class="card" id="cardCore">
                    <div class="card-header">
                        <h3 class="card-title">Appointments Detail</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-9 col-md-12 col-lg-5 order-2 order-md-1">
                                <div id="inline-calendar">

                                </div>
                                <div class="mt-2">
                                    <button class="btn btn-sm btn-primary" onclick="openAddModal()">
                                        Add Appointment
                                    </button>
                                    <button class="btn btn-sm btn-outline-info" onclick="clearDateFilter()">
                                        Show All Appointments
                                    </button>
                                    <button class="btn btn-sm btn-outline-info" onclick="showCanceled()">
                                        Show canceled Appointments
                                    </button>
                                </div>
                                <div class="card p-3 mt-2">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span id="statsLabel">Appointments this month</span>
                                        <span id="statsCount"></span>
                                    </div>
                                    <div style="background:#e9ecef; border-radius:4px; height:8px; width:100%;">
                                        <div id="progressBar" style="height:8px; border-radius:4px; transition: width 0.6s ease;"></div>
                                    </div>
                                    <small id="month" class="text-muted mt-1"></small>
                                    <small id="confirmedMonth" class="text-muted mt-1"></small>
                                    <small id="canceldMonth" class="text-muted mt-1"></small>

                                    <div class="d-flex justify-content-between mb-1">
                                        <span id="statsLabelToday" class="pt-2">Appointments today</span>
                                        <span id="statsCountToday"></span>
                                    </div>
                                    <div style="background:#e9ecef; border-radius:4px; height:8px; width:100%;">
                                        <div id="progressBarToday" style="height:8px; border-radius:4px; transition: width 0.6s ease;"></div>
                                    </div>
                                    <small id="dayCountConfirmed" class="text-muted mt-1"></small>
                                    <small id="dayCountCanceld" class="text-muted mt-1"></small>
                                </div>
                            </div>
                            <div class="col-12 col-md-12 col-lg-6 order-1 order-md-2 ml-5">
                                <div>
                                    <table class="table" id="dataTable">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Phone</th>
                                                <th>Subject</th>
                                                <th>Time</th>
                                                <th id="colTitle"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="dataTableBody">

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->

            </section>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->

        <!-- /.control-sidebar -->
    </div>
    <div class="modal fade" id="EditModel" tabindex="-1" role="dialog" aria-labelledby="editAppoitment" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editAppoitment">Reschedule Appointment</h5>
                    <button type="button" class="close text-white" data-bs-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <form method="post" asp-action="EditApt" id="AppointmentForm">
                        <input asp-for="AppointmentId" type="hidden" id="editId" />
                        <div class="row gtr-uniform">
                            <div class="col-12 mb-3">
                                <input asp-for="PatientName" id="editName" class="form-control" placeholder="Patient Name" readonly />
                                <span asp-validation-for="PatientName" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <input asp-for="Email" id="editEmail" class="form-control" placeholder="Email" readonly />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <input asp-for="PhoneNumber" id="editPhone" class="form-control" placeholder="Phone Number" readonly />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <select asp-for="Subject" id="editSubject" class="form-control" asp-items="Model.SubjectList"></select>
                            </div>
                            <div class="col-6 mb-3">
                                <input type="text"
                                       id="scheduleDate"
                                       class="form-control"
                                       placeholder="Select available date"
                                       readonly />
                                <input type="hidden" asp-for="ScheduleId" id="editDate" />
                            </div>
                            <div class="col-6 mb-3">
                                <select asp-for="SlotStartTimeString"
                                        asp-items="Model.AvailableSlots"
                                        class="form-control"
                                        id="editTime"
                                        disabled>
                                    <option value="">-- Select Time Slot --</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" onclick="ConfirmEdit()">Edit</button>
                            <button type="button" class="btn btn-danger" onclick="ConfirmDelete()">DELETE</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>





    <div class="modal fade" id="AddModel" tabindex="-1" role="dialog" aria-labelledby="addAppoitment" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addAppoitment">Add Appointment</h5>
                    <button type="button" class="close text-white" data-bs-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <form method="post" asp-action="AddApt" id="AppointmentForm">
                        <input asp-for="AppointmentId" type="hidden" id="addId" />
                        <div class="row gtr-uniform">
                            <div class="col-12 mb-3">
                                <input asp-for="PatientName" id="addName" class="form-control" placeholder="Patient Name" />
                                <span asp-validation-for="PatientName" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <input asp-for="PhoneNumber" id="addPhone" class="form-control" placeholder="Phone number" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <select asp-for="Subject" id="addSubject" class="form-control" asp-items="Model.SubjectList"></select>
                            </div>
                            <div class="col-6 mb-3">
                                <input type="text"
                                       id="AddscheduleDate"
                                       class="form-control"
                                       placeholder="Select available date"
                                       readonly />
                                <input type="hidden" asp-for="ScheduleId" id="addDate" />
                            </div>
                            <div class="col-6 mb-3">
                                <select asp-for="SlotStartTimeString"
                                        asp-items="Model.AvailableSlots"
                                        class="form-control"
                                        id="addTime"
                                        disabled>
                                    <option value="">-- Select Time Slot --</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" onclick="ConfirmAdd()">Add</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <!-- ./wrapper -->
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    @section Scripts {
        <script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            $(document).ready(async function () {
                 async function loadAppointments(dateStr) {
                    const tableBody = document.getElementById("dataTableBody");

                    if ($.fn.DataTable.isDataTable('#dataTable')) {
                        $('#dataTable').DataTable().destroy();
                    }
                    tableBody.innerHTML = "";

                    const url = dateStr
                        ? `/Admin/Appointment/GetAppointment?Date=${dateStr}`
                        : `/Admin/Appointment/GetAppointment`;

                    const aptResponse = await fetch(url);
                    const aptData = await aptResponse.json();

                    aptData.forEach(appointment => {
                        const row = document.createElement("tr");

                        const DateCell = document.createElement("td");
                        DateCell.textContent = appointment.date;
                        row.appendChild(DateCell);

                        const nameCell = document.createElement("td");
                        nameCell.textContent = appointment.patientName;
                        row.appendChild(nameCell);

                        const emailCell = document.createElement("td");
                        emailCell.textContent = appointment.email;
                        row.appendChild(emailCell);

                        const phoneCell = document.createElement("td");
                        phoneCell.textContent = appointment.phoneNumber;
                        row.appendChild(phoneCell);

                        const subjectCell = document.createElement("td");
                        subjectCell.textContent = appointment.subject;
                        row.appendChild(subjectCell);

                        const timeCell = document.createElement("td");
                        timeCell.textContent = appointment.slotStartTime;
                        row.appendChild(timeCell);

                        document.getElementById("colTitle").innerHTML = "Action";
                        const actionCell = document.createElement("td");
                        const editBtn = document.createElement("button");
                        editBtn.className = "btn btn-sm btn-info";
                        editBtn.innerHTML = '<i class="fas fa-edit"></i> Edit';
                        editBtn.addEventListener("click", () => openEditModal(appointment));
                        actionCell.appendChild(editBtn);
                        row.appendChild(actionCell);

                        tableBody.appendChild(row);
                    });

                    $('#dataTable').DataTable();
                }
                async function loadCalendar(){
                    const response = await fetch("/Admin/appointment/GetDates");
                    const setDates = await response.json();

                    // Load ALL appointments on page load
                    await loadAppointments(null);

                    flatpickr("#inline-calendar", {
                        inline: true,
                        dateFormat: "Y-m-d",
                        enable: setDates,
                        onChange: async function (selectedDates, dateStr) {
                            await loadAppointments(dateStr);
                        },
                    });
                }

                loadCalendar();
            });

            async function showCanceled(){
                const res = await fetch("/Admin/appointment/GetCanceled");
                const data = await res.json();

                const tableBody = document.getElementById("dataTableBody");

                if ($.fn.DataTable.isDataTable('#dataTable')) {
                    $('#dataTable').DataTable().destroy();
                }

                tableBody.innerHTML = "";

                data.forEach(apt => {
                    const row = document.createElement("tr");

                    const DateCell = document.createElement("td");
                    DateCell.textContent = apt.date;
                    row.appendChild(DateCell);

                    const nameCell = document.createElement("td");
                    nameCell.textContent = apt.patientName;
                    row.appendChild(nameCell);

                    const emailCell = document.createElement("td");
                    emailCell.textContent = apt.email;
                    row.appendChild(emailCell);

                    const phoneCell = document.createElement("td");
                    phoneCell.textContent = apt.phoneNumber;
                    row.appendChild(phoneCell);

                    const subjectCell = document.createElement("td");
                    subjectCell.textContent = apt.subject;
                    row.appendChild(subjectCell);

                    const timeCell = document.createElement("td");
                    timeCell.textContent = apt.slotStartTime;
                    row.appendChild(timeCell);

                    document.getElementById("colTitle").innerHTML = "Canceled";
                    const statusCell = document.createElement("td");
                    statusCell.textContent = apt.deletedAt
                    row.appendChild(statusCell);

                    tableBody.appendChild(row);
                });
                $('#dataTable').DataTable();
            }

            function openAddModal(){
                    $('#AddModel').modal('show');
                }

                function openEditModal(data){
                    document.getElementById("editId").value = data.id;
                    document.getElementById("editName").value = data.patientName;
                    document.getElementById("editEmail").value = data.email;
                    document.getElementById("editPhone").value = data.phoneNumber;
                    document.getElementById("editSubject").value = data.subject;
                    document.getElementById("editDate").value = data.date;
                    document.getElementById("editTime").value = data.slotStartTime;

                    $('#EditModel').modal('show');
                }
            async function ConfirmDelete(){
                    event.preventDefault();
                    const id = document.getElementById("editId").value;
                    Swal.fire({
                    title: "Are you sure?",
                    text: "You won't be able to revert this!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete it!"
                    }).then( async (result) => {
                        if (result.isConfirmed){
                            const response = await fetch(`/Admin/appointment/DeleteApt?id=${id}`,{
                                method:"POST"
                            });
                            if(response.ok){
                                await Swal.fire({
                                    title: "Deleted!",
                                    text: "Appointment  has been deleted.",
                                    icon: "success"
                                });
                                location.reload();
                            }
                            else{
                                await Swal.fire({
                                    title: "ERROR!",
                                    text: "Something went wrong",
                                    icon: "error"
                                });
                                location.reload();
                            }
                        }
                    });
            }
            async function ConfirmAdd(){
                    event.preventDefault();
                    const viewmodel = {
                        AppointmentId: document.getElementById("addId").value,
                        PatientName: document.getElementById("addName").value,
                        phoneNumber: document.getElementById("addPhone").value,
                        Subject: document.getElementById("addSubject").value,
                        ScheduleId: document.getElementById("addDate").value,
                        SlotStartTimeString: document.getElementById("addTime").value
                    };
                    Swal.fire({
                    title: "Are you sure?",
                    text: "Do you want to add this appointment?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, Add it!"
                    }).then( async (result) => {
                        if (result.isConfirmed){
                            const response = await fetch(`/Admin/appointment/AddApt`,{
                                method:"POST",
                                headers: {
                                    "Content-Type": "application/json"
                                 },
                                body: JSON.stringify(viewmodel)
                            });
                            if(response.ok){
                                Swal.fire({
                                    title: "Added!",
                                    text: "Appointment  has been Added.",
                                    icon: "success"
                                });
                                location.reload();
                            }
                            else{
                                Swal.fire({
                                    title: "ERROR!",
                                    text: "Something went wrong",
                                    icon: "error"
                                });
                            }
                        }
                    });
            }
            async function ConfirmEdit(){
                    event.preventDefault();
                    const viewmodel = {
                        AppointmentId: document.getElementById("editId").value,
                        PatientName: document.getElementById("editName").value,
                        Email: document.getElementById("editEmail").value,
                        PhoneNumber: document.getElementById("editPhone").value,
                        Subject: document.getElementById("editSubject").value,
                        ScheduleId: document.getElementById("editDate").value,
                        SlotStartTimeString: document.getElementById("editTime").value
                    };
                    Swal.fire({
                    title: "Are you sure?",
                    text: "Do you want to confirm the edit?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, Edit it!"
                    }).then( async (result) => {
                        if (result.isConfirmed){
                            const response = await fetch(`/Admin/appointment/EditApt`,{
                                method:"POST",
                                headers: {
                                    "Content-Type": "application/json"
                                 },
                                body: JSON.stringify(viewmodel)
                            });
                            if(response.ok){
                                Swal.fire({
                                    title: "Edited!",
                                    text: "Appointment  has been Changed.",
                                    icon: "success"
                                });
                                location.reload();
                            }
                            else{
                                Swal.fire({
                                    title: "ERROR!",
                                    text: "Something went wrong",
                                    icon: "error"
                                });
                            }
                        }
                    });
            }
            function clearDateFilter() {
                document.querySelector("#inline-calendar")._flatpickr.clear();
                loadAppointments(null);
            }
        </script>
        <script>
            async function loadaddDates(){
                const response = await fetch("/Admin/appointment/GetDates");
                const setDates = await response.json();
                flatpickr("#AddscheduleDate", {
                    enable: setDates,
                    dateFormat: "Y-m-d",
                    minDate: "today",
                    onChange: async function (selectedDates, dateStr) {

                        document.getElementById("AddscheduleDate").value = dateStr;

                        const res = await fetch(`/Admin/appointment/FindDates?Date=${dateStr}`);
                        const data = await res.json();

                        document.getElementById("addDate").value = data.id;

                        const slotSelect = document.getElementById("addTime");
                        slotSelect.innerHTML = '<option value="">-- Select Time Slot --</option>';
                        slotSelect.disabled = true;
                        fetch(`/User/GetSlots?scheduleId=${data.id}`)
                            .then(res => res.json())
                            .then(data => {
                                data.forEach(slot => {
                                    const option = document.createElement("option");
                                    option.value = slot.value;
                                    option.text = slot.text;
                                    slotSelect.appendChild(option);
                                });
                                slotSelect.disabled = false;
                            });
                    }
                });
            }
            loadaddDates();
        </script>
        <script>
            async function loadDates(){
                const response = await fetch("/Admin/appointment/GetDates");
                const setDates = await response.json();
                flatpickr("#scheduleDate", {
                    enable: setDates,
                    dateFormat: "Y-m-d",
                    minDate: "today",
                    onChange: async function (selectedDates, dateStr) {

                        document.getElementById("scheduleDate").value = dateStr;

                        const res = await fetch(`/Admin/appointment/FindDates?Date=${dateStr}`);
                        const data = await res.json();

                        document.getElementById("editDate").value = data.id;

                        const slotSelect = document.getElementById("editTime");
                        slotSelect.innerHTML = '<option value="">-- Select Time Slot --</option>';
                        slotSelect.disabled = true;
                        console.log(data.id);
                        fetch(`/User/GetSlots?scheduleId=${data.id}`)
                            .then(res => res.json())
                            .then(data => {
                                data.forEach(slot => {
                                    const option = document.createElement("option");
                                    option.value = slot.value;
                                    option.text = slot.text;
                                    slotSelect.appendChild(option);
                                });
                                slotSelect.disabled = false;
                            });
                    }
                });
            }
            loadDates();
        </script>
        <script>
            async function loadStats(){
                console.log("In loadStats");
                const res = await fetch("/Admin/Appointment/GetStats");
                const data = await res.json();

                const bar = document.getElementById("progressBar");
                const barToday = document.getElementById("progressBarToday");
                const colorBlue = "#1E90FF";
                const colorRed = "#fc1212";
                const colorYellow = "#fce112";
                const colorGreen = "#12fc7b"

                document.getElementById("statsCount").textContent = `${data.active} / ${data.total}`;
                document.getElementById("statsCountToday").textContent = `${data.activeToday} / ${data.totalToday}`;
                document.getElementById("dayCountConfirmed").textContent = `${data.percentToday}% confirmed`;
                document.getElementById("dayCountCanceld").textContent = `${100 -data.percentToday}% canceld`;
                document.getElementById("month").textContent = `${data.month} — `;
                document.getElementById("confirmedMonth").textContent = `${data.percent}% confirmed/finished`;
                document.getElementById("canceldMonth").textContent = `${100 - data.percent}% canceld`;

                setTimeout(() => {
                    bar.style.background = colorBlue;
                    bar.style.width = `${data.percent}%`;
                    console.log("percent: ", data.percentToday);
                    if(data.percentToday >= 65)
                    barToday.style.background = colorGreen;
                    else if (data.percentToday <= 35)
                    barToday.style.background = colorRed;
                    else
                    barToday.style.background = colorYellow;
                    barToday.style.width = `${data.percentToday}%`;
                }, 100);
            }
            loadStats();
        </script>
    }
</body>
</html>
