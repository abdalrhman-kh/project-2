@model project_2.ViewModels.AppointmentViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AdminLTE 3 | Project Detail</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/ViewAppointmentTemplate/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        #cardCore{
            min-height: calc(100vh - 100px);
        }
    </style>
</head>
<body class="hold-transition sidebar-mini">
    <!-- Site wrapper -->
    <div class="wrapper">
        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper" style="margin-left:0;">
            <!-- Content Header (Page header) -->
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            @* <h1>Project Detail</h1> *@
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item active">Appointments Detail</li>
                            </ol>
                        </div>
                    </div>
                </div><!-- /.container-fluid -->
            </section>

            <!-- Main content -->
            <section class="content">

                <!-- Default box -->
                <div class="card" id="cardCore">
                    <div class="card-header">
                        <h3 class="card-title">Appointments Detail</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-7 order-2 order-md-1">
                                <div id="inline-calendar">

                                </div>
                            </div>
                            <div class="col-12 col-md-12 col-lg-4 order-1 order-md-2 ml-5">
                                <div>
                                    <table class="table" id="dataTable">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Phone</th>
                                                <th>Subject</th>
                                                <th>Time</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="dataTableBody">

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->

            </section>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->

        <!-- /.control-sidebar -->
    </div>
    <div class="modal fade" id="EditModel" tabindex="-1" role="dialog" aria-labelledby="editAppoitment" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editAppoitment">Reschedule Appointment</h5>
                    <button type="button" class="close text-white" data-bs-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <form method="post" asp-action="EditApt" id="AppointmentForm">
                        <input asp-for="AppointmentId" type="hidden" id="editId" />
                        <div class="row gtr-uniform">
                            <div class="col-12 mb-3">
                                <input asp-for="PatientName" id="editName" class="form-control" placeholder="Patient Name" readonly />
                                <span asp-validation-for="PatientName" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <input asp-for="Email" id="editEmail" class="form-control" placeholder="Email" readonly />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <input asp-for="PhoneNumber" id="editPhone" class="form-control" placeholder="Phone Number" readonly />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <select asp-for="Subject" id="editSubject" class="form-control" asp-items="Model.SubjectList"></select>
                            </div>
                            <div class="col-6 mb-3">
                                <input type="text"
                                       id="scheduleDate"
                                       class="form-control"
                                       placeholder="Select available date"
                                       readonly />
                                <input type="hidden" asp-for="ScheduleId" id="editDate" />
                            </div>
                            <div class="col-6 mb-3">
                                <select asp-for="SlotStartTimeString"
                                        asp-items="Model.AvailableSlots"
                                        class="form-control"
                                        id="editTime"
                                        disabled>
                                    <option value="">-- Select Time Slot --</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" onclick="ConfirmEdit()">Edit</button>
                            <button type="button" class="btn btn-danger" onclick="ConfirmDelete()">DELETE</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- ./wrapper -->
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <!-- AdminLTE App -->
    <script src="~/ViewAppointmentTemplate/js/adminlte.min.js"></script>

    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function(){
            $('#dataTable').DataTable();
        });
    </script>

    <script>
        async function loadCalendar(){
            const response = await fetch("/Admin/appointment/GetDates");
            const setDates = await response.json();
            const tableCore = document.getElementById("dataTable");
            const tableBody = document.getElementById("dataTableBody");

            flatpickr("#inline-calendar",{
                inline: true,
                dateFormat: "Y-m-d",
                enable: setDates,
                onChange: async function (selectedDates, dateStr) {
                    if ($.fn.DataTable.isDataTable('#dataTable')) {
                            $('#dataTable').DataTable().destroy();
                    }
                    tableBody.innerHTML="";
                    const aptResponse = await fetch(`/Admin/Appointment/GetAppointment?Date=${dateStr}`);
                    aptData = await aptResponse.json();
                    aptData.forEach(appointment =>{
                        const actionCell = document.createElement("td");
                        const editBtn = document.createElement("button");
                        editBtn.className = "btn btn-sm btn-info";
                        editBtn.innerHTML = '<i class="fas fa-edit"></i> Edit';

                        actionCell.appendChild(editBtn);

                        editBtn.addEventListener("click", () => openEditModal(appointment));
                        const row = document.createElement("tr");
                        
                        const nameCell = document.createElement("td");
                        nameCell.textContent = appointment.patientName;
                        row.appendChild(nameCell);

                        const emailCell = document.createElement("td");
                        emailCell.textContent = appointment.email;
                        row.appendChild(emailCell);

                        const phoneCell = document.createElement("td");
                        phoneCell.textContent = appointment.phoneNumber;
                        row.appendChild(phoneCell);

                        const subjectCell = document.createElement("td");
                        subjectCell.textContent = appointment.subject;
                        console.log("subject:" + appointment.subject)
                        row.appendChild(subjectCell);

                        const timeCell = document.createElement("td");
                        timeCell.textContent = appointment.slotStartTime;
                        row.appendChild(timeCell);

                        row.appendChild(actionCell);

                        tableBody.appendChild(row);
                    })
                    $('#dataTable').DataTable();
                },
            })
        }

        loadCalendar();

        function openEditModal(data){
            document.getElementById("editId").value = data.id;
            document.getElementById("editName").value = data.patientName;
            document.getElementById("editEmail").value = data.email;
            document.getElementById("editPhone").value = data.phoneNumber;
            document.getElementById("editSubject").value = data.subject;
            document.getElementById("editDate").value = data.date;
            document.getElementById("editTime").value = data.slotStartTime;

            $('#EditModel').modal('show');
        }
        async function ConfirmDelete(){
            event.preventDefault();
            const id = document.getElementById("editId").value;
            Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
            }).then( async (result) => {
                if (result.isConfirmed){
                    const response = await fetch(`/Admin/appointment/DeleteApt?id=${id}`,{
                        method:"POST"
                    });
                    if(response.ok){
                        await Swal.fire({
                            title: "Deleted!",
                            text: "Appointment  has been deleted.",
                            icon: "success"
                        });
                        location.reload();
                    }
                    else{
                        await Swal.fire({
                            title: "ERROR!",
                            text: "Something went wrong",
                            icon: "error"
                        });
                        location.reload();
                    }
                }
            });
        }
        async function ConfirmEdit(){
            event.preventDefault();
            const viewmodel = {
                AppointmentId: document.getElementById("editId").value,
                PatientName: document.getElementById("editName").value,
                Email: document.getElementById("editEmail").value,
                PhoneNumber: document.getElementById("editPhone").value,
                Subject: document.getElementById("editSubject").value,
                ScheduleId: document.getElementById("editDate").value,
                SlotStartTimeString: document.getElementById("editTime").value
            };
            Swal.fire({
            title: "Are you sure?",
            text: "Do you want to confirm the edit?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, Edit it!"
            }).then( async (result) => {
                if (result.isConfirmed){
                    const response = await fetch(`/Admin/appointment/EditApt`,{
                        method:"POST",
                        headers: {
                            "Content-Type": "application/json"
                         },
                        body: JSON.stringify(viewmodel)
                    });
                    if(response.ok){
                        Swal.fire({
                            title: "Edited!",
                            text: "Appointment  has been Changed.",
                            icon: "success"
                        });
                        location.reload();
                    }
                    else{
                        Swal.fire({
                            title: "ERROR!",
                            text: "Something went wrong",
                            icon: "error"
                        });
                    }
                }
            });
        }
    </script>
    <script>
        async function loadDates(){
            const response = await fetch("/Admin/appointment/GetDates");
            const setDates = await response.json();
            flatpickr("#scheduleDate", {
                enable: setDates,
                dateFormat: "Y-m-d",
                minDate: "today",
                onChange: async function (selectedDates, dateStr) {

                    document.getElementById("scheduleDate").value = dateStr;

                    const res = await fetch(`/Admin/appointment/FindDates?Date=${dateStr}`);
                    const data = await res.json();

                    document.getElementById("editDate").value = data.id;

                    const slotSelect = document.getElementById("editTime");
                    slotSelect.innerHTML = '<option value="">-- Select Time Slot --</option>';
                    slotSelect.disabled = true;
                    console.log(data.id);
                    fetch(`/User/GetSlots?scheduleId=${data.id}`)
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(slot => {
                                const option = document.createElement("option");
                                option.value = slot.value;
                                option.text = slot.text;
                                slotSelect.appendChild(option);
                            });
                            slotSelect.disabled = false;
                        });
                }
            });
        }
        loadDates();
    </script>
</body>
</html>
